OPENAI_API_KEY=sk-...

# Zugangsdaten für den lokalen Postgres+pgvector-Container (docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=immobilien_rag
POSTGRES_USER=immobilien_rag
POSTGRES_PASSWORD=immobilien_rag

# Optional: nur gesetzt in der Deployment-Umgebung (siehe render.yaml),
# aktiviert einen einfachen Basic-Auth-Zugriffsschutz für die Web-UI.
# Lokal leer lassen.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
